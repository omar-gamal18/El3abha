    "execute": [
      {
        "description": "create table \"Venue\"",
        "sql": "CREATE TABLE \"public\".\"Venue\" (\n  \"bookingDuration\" int4 DEFAULT 60 NOT NULL,\n  \"city\" text NOT NULL,\n  \"closingTime\" text DEFAULT '03:00' NOT NULL,\n  \"contactPhone\" text NOT NULL,\n  \"createdAt\" timestamp(3) DEFAULT (now()) NOT NULL,\n  \"description\" text NOT NULL,\n  \"facilities\" \"Facility\"[],\n  \"hourlyPrice\" int4 NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"isActive\" bool DEFAULT true NOT NULL,\n  \"latitude\" float8,\n  \"longitude\" float8,\n  \"name\" text NOT NULL,\n  \"neighborhood\" text NOT NULL,\n  \"openingTime\" text DEFAULT '12:00' NOT NULL,\n  \"ownerId\" int4 NOT NULL,\n  \"photos\" text[],\n  \"pitchSize\" \"PitchSize\" NOT NULL,\n  \"rejectionReason\" text,\n  \"sportCategory\" \"SportCategory\" NOT NULL,\n  \"status\" \"VenueStatus\" DEFAULT 'pending'::\"VenueStatus\" NOT NULL,\n  \"streetAddress\" text NOT NULL,\n  \"surface\" \"PitchSurface\" NOT NULL,\n  \"updatedAt\" timestamp(3) NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Venue\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
