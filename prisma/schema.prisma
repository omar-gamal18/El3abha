datasource db {
    provider = "postgresql"
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    phone     Int
    password  String
    role      UserRole
    isActive  Boolean
    createdAt DateTime @default(now())
}

enum UserRole {
    PLAYER
    OWNER
}
